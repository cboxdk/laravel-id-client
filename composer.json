{
    "name": "cboxdk/laravel-id-client",
    "description": "Laravel/PHP consumer SDK for Cbox ID — turnkey OIDC login, hosted profile-management redirect, machine tokens, and webhook verification against a Cbox ID instance.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cbox",
        "identity",
        "oidc",
        "sso",
        "authentication",
        "client",
        "sdk",
        "laravel"
    ],
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^7.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "suggest": {
        "cboxdk/laravel-console-kit": "The shared Cbox shell: Shell\\OrganizationLevel plugs the person's organizations into its context selectors."
    },
    "require-dev": {
        "cboxdk/laravel-console-kit": "^0.2.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Id\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Id\\Client\\Tests\\": "tests/",
            "Cbox\\Id\\Client\\Generator\\": "generator/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Id\\Client\\ClientServiceProvider"
            ],
            "aliases": {
                "CboxId": "Cbox\\Id\\Client\\Facades\\CboxId",
                "CboxIdApi": "Cbox\\Id\\Client\\Facades\\CboxIdApi"
            }
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "generate": "@php bin/generate-management",
        "generate:check": "@php bin/generate-management --check",
        "generate:v1": "@php bin/generate-v1-routes",
        "generate:v1:check": "@php bin/generate-v1-routes --check",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@generate:check",
            "@generate:v1:check",
            "@license-check",
            "@composer audit --no-dev"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
